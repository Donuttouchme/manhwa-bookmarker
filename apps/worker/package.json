{
  "name": "@manhwa/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env.local -- tsx src/index.ts",
    "probe": "dotenv -e ../../.env.local -- tsx src/probe.ts",
    "install-extensions": "dotenv -e ../../.env.local -- tsx src/install-extensions.ts",
    "install-extensions:ci": "tsx src/install-extensions.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@manhwa/db": "workspace:*",
    "@manhwa/sources": "workspace:*",
    "@sentry/node": "^8",
    "pg-boss": "^10"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.11.0",
    "typescript": "^6.0.3"
  }
}
