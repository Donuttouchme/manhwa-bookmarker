{
  "name": "manhwa-bookmarker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @manhwa/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "dotenv -e .env.local -- pnpm --filter @manhwa/db exec prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- pnpm --filter @manhwa/db exec prisma studio",
    "db:generate": "dotenv -e .env.local -- pnpm --filter @manhwa/db exec prisma generate",
    "worker:dev": "pnpm --filter @manhwa/worker dev",
    "worker:start": "pnpm --filter @manhwa/worker start",
    "worker:probe": "pnpm --filter @manhwa/worker probe",
    "worker:install-extensions": "pnpm --filter @manhwa/worker exec dotenv -e ../../.env.local -- tsx src/install-extensions.ts",
    "worker:install-extensions:ci": "pnpm --filter @manhwa/worker run install-extensions:ci",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:reset": "docker compose down -v && docker compose up -d",
    "prepare": "husky"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^17.0.7",
    "prettier": "^3.2.5",
    "typescript": "^6.0.3"
  }
}
