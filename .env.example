# ====================================
# Local development environment variables.
# Copy to `.env.local` and fill in real values.
# NEVER commit `.env.local` — it is gitignored.
# ====================================

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL="postgresql://manhwa:manhwa_dev_password@localhost:5432/manhwa?schema=public"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Magic-link email (SMTP) ---
# In local dev, points at Mailpit (caught at http://localhost:8025).
# In staging/prod we swap this for Resend (Plan 4).
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT="1025"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
EMAIL_FROM="Manhwa Bookmarker <noreply@manhwa-bookmarker.local>"

# --- Suwayomi-Server (manga source backend) ---
# Runs in docker-compose; web UI + REST + GraphQL at this URL.
SUWAYOMI_URL="http://localhost:4567"

# --- Magic-link email (production) ---
# Resend SMTP. Sign up at https://resend.com → API Keys → create a key with "Sending access".
# The user portion of EMAIL_FROM must be on a domain you've verified in Resend.
# NOTE: Auth.js built-in email provider uses EMAIL_SERVER_* (different from the
# EMAIL_SMTP_* keys above which are used by the custom nodemailer transport in local dev).
# In production, set these via Fly secrets; the EMAIL_SMTP_* keys are unused in prod.
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM is shared between local and prod — override this secret in Fly for prod:
# EMAIL_FROM="noreply@yourdomain.com"

# --- Google OAuth (production sign-in) ---
# Cloud Console → APIs & Services → Credentials → Create OAuth client → Web application.
# Redirect URI: https://manhwa-web-prod.fly.dev/api/auth/callback/google (+ staging mirror)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Sentry (error reporting) ---
# Get DSN from sentry.io → Settings → Projects → manhwa-web-prod → Client Keys (DSN).
# SENTRY_AUTH_TOKEN is needed only at build time for source-map upload (skip in dev).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
